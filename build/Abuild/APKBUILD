# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=xfce4
pkgver=4.21
pkgrel=0
pkgdesc="XFCE 4 meta package"
url="https://xfce.org"
arch="noarch"
license="GPL-2.0-or-later"
# https://mail.xfce.org/pipermail/xfce-announce/2024-December/001481.html
# libxfce4util and libxfce4windowing 4.21 are not out yet
depends="
	exo>=$pkgver
	font-dejavu
	garcon>=0.8
	libxfce4ui>=$pkgver
	libxfce4util>=4.20
	libxfce4windowing>=4.20
	thunar>=$pkgver
	tumbler>=$pkgver
	xfce4-appfinder>=$pkgver
	xfce4-panel>=$pkgver
	xfce4-session>=$pkgver
	xfce4-settings>=$pkgver
	xfconf>=$pkgver
	"

package() {
	mkdir -p "$pkgdir"
}

:
